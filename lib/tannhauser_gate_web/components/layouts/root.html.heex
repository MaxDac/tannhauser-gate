<!DOCTYPE html>
<html lang="en" data-theme="platform" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#0b100d" />
    <.live_title default="Tannhauser Gate" suffix=" · Tannhauser Gate" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={~p"/favicon.ico"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/images/favicon-16.png"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32.png"} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={~p"/favicon.svg"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="city-bg min-h-screen text-base-content antialiased">
    {@inner_content}
  </body>
</html>
