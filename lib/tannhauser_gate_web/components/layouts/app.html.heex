<%= if @current_user do %>
  <div class="min-h-screen lg:flex">
    <header class="flex items-center justify-between border-b border-mint/20 bg-ink/90 px-4 py-3 lg:hidden">
      <.link navigate={~p"/characters"}><.brand size={32} /></.link>
      <button
        type="button"
        id="drawer-toggle"
        class="rounded-md border border-mint/40 p-2 text-mint"
        aria-label="Toggle navigation"
        phx-click={JS.toggle(to: "#drawer")}
      >
        <.icon name="hero-bars-3" class="h-5 w-5" />
      </button>
    </header>

    <aside
      id="drawer"
      class="hidden w-full shrink-0 border-r border-mint/20 bg-ink/95 lg:sticky lg:top-0 lg:block lg:h-screen lg:w-64"
    >
      <div class="flex h-full flex-col gap-6 p-4">
        <.link navigate={~p"/characters"} class="hidden lg:block">
          <.brand size={36} />
        </.link>

        <nav class="flex flex-col gap-1" aria-label="Sections">
          <.nav_link
            navigate={~p"/characters"}
            icon="hero-identification"
            current_path={assigns[:current_path]}
          >
            Characters
          </.nav_link>
          <.nav_link navigate={~p"/map"} icon="hero-map" current_path={assigns[:current_path]}>
            City Map
          </.nav_link>
          <.nav_link
            navigate={~p"/forum"}
            icon="hero-chat-bubble-left-right"
            current_path={assigns[:current_path]}
          >
            Forum
          </.nav_link>
          <.nav_link
            :if={TannhauserGate.Accounts.admin?(@current_user)}
            navigate={~p"/admin"}
            icon="hero-shield-check"
            current_path={assigns[:current_path]}
          >
            Admin
          </.nav_link>
        </nav>

        <div class="mt-auto flex flex-col gap-1 border-t border-mint/20 pt-4">
          <p class="truncate px-3 text-xs text-fog-400" title={@current_user.email}>
            {@current_user.email}
          </p>
          <.nav_link
            navigate={~p"/users/settings"}
            icon="hero-cog-6-tooth"
            current_path={assigns[:current_path]}
          >
            Settings
          </.nav_link>
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="flex items-center gap-3 rounded-md px-3 py-2 text-sm font-semibold uppercase tracking-wider text-fog-300 hover:bg-phosphor/10 hover:text-phosphor"
          >
            <.icon name="hero-arrow-left-on-rectangle" class="h-5 w-5" /> Log out
          </.link>
        </div>
      </div>
    </aside>

    <main class="min-w-0 flex-1 px-4 py-8 sm:px-6 lg:px-10">
      <div class="mx-auto max-w-6xl">
        <.flash_group flash={@flash} />
        {@inner_content}
      </div>
    </main>
  </div>
<% else %>
  <main class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
    <.link href={~p"/"} class="mb-10"><.brand size={56} /></.link>
    <div class="w-full max-w-md rounded-xl border border-mint/30 bg-ink/80 p-8 shadow-phosphor backdrop-blur">
      <.flash_group flash={@flash} />
      {@inner_content}
    </div>
    <p class="mt-8 text-xs uppercase tracking-[0.3em] text-fog-500">
      Neo-Meridian · 2121
    </p>
  </main>
<% end %>
